#!/usr/bin/env bash
# Wrapper script to run port validation in AutoCoder's venv

cd ~/projects/autocoder

if [ -d "venv" ]; then
    source venv/bin/activate
    python3 bin/validate-port-assignments "$@"
else
    echo "❌ AutoCoder venv not found. Run 'autocoder-ui' first to create it."
    exit 1
fi
